local ChamsSettings = {
    Enabled = false,
    Mode = "Filled",              
    VisibleColor = Color3.fromRGB(255, 70, 70),
    OccludedColor = Color3.fromRGB(255, 200, 70),
    FillTransparency = 0.5,
    OutlineTransparency = 0,
    TeamCheck = true,
    UseOccludedCheck = true,      
}

local ChamsHighlights = {}

local function DestroyChams(player)
    local hl = ChamsHighlights[player]
    if hl then hl:Destroy() end
    ChamsHighlights[player] = nil
end

local function UpdateChams()
    if not ChamsSettings.Enabled then
        for p in pairs(ChamsHighlights) do DestroyChams(p) end
        return
    end

    local current = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if ChamsSettings.TeamCheck and myTeam and player.Team == myTeam then continue end

        local char = GetChar(player)
        if not char or not char.Parent then continue end

        local head = char:FindFirstChild("Head")
        if not head then continue end

        current[player] = true

        local hl = ChamsHighlights[player]
        if not hl or hl.Adornee ~= char then
            if hl then hl:Destroy() end
            hl = Instance.new("Highlight")
            hl.Name = tostring(math.random(100000, 999999)) 
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Adornee = char
            hl.Parent = game:GetService("CoreGui")            
            ChamsHighlights[player] = hl
        end

        local color = ChamsSettings.VisibleColor
        if ChamsSettings.UseOccludedCheck then
            local torso = char:FindFirstChild("Torso") or head
            local isVisible = IsVisible(torso)
            color = isVisible and ChamsSettings.VisibleColor or ChamsSettings.OccludedColor
        end

        if ChamsSettings.Mode == "Filled" then
            hl.FillColor = color
            hl.OutlineColor = color
            hl.FillTransparency = ChamsSettings.FillTransparency
            hl.OutlineTransparency = 1
        elseif ChamsSettings.Mode == "Outline" then
            hl.FillColor = color
            hl.OutlineColor = color
            hl.FillTransparency = 1
            hl.OutlineTransparency = ChamsSettings.OutlineTransparency
        end
    end

    for p in pairs(ChamsHighlights) do
        if not current[p] then DestroyChams(p) end
    end
end

task.spawn(function()
    while task.wait(1/30) do
        UpdateChams()
    end
end)

