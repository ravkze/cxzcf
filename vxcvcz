local function CreateLine()
    local ok, l = pcall(function() return Drawing.new("Line") end)
    if not ok or not l then return nil end
    l.Thickness = 1; l.Transparency = 1; l.Visible = false
    return l
end

local function CreateText()
    local ok, t = pcall(function() return Drawing.new("Text") end)
    if not ok or not t then return nil end
    t.Text = ""; t.Size = 12; t.Font = 2; t.Center = true
    t.Outline = true; t.OutlineColor = Color3.fromRGB(0, 0, 0)
    t.Color = Color3.fromRGB(255, 255, 255); t.Transparency = 1; t.Visible = false
    return t
end

local function CreateCircle()
    local ok, c = pcall(function() return Drawing.new("Circle") end)
    if not ok or not c then return nil end
    c.Thickness = 1; c.NumSides = 16; c.Filled = true
    c.Transparency = 1; c.Color = Color3.fromRGB(255, 255, 255); c.Visible = false
    return c
end

local function CalculateBounds(char)
    if not char or not char.Parent then return nil end
    local corners = {}
    for _, partName in ipairs(BODY_PARTS) do
        local part = char:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            local cf, sz = part.CFrame, part.Size
            for x = -1, 1, 2 do for y = -1, 1, 2 do for z = -1, 1, 2 do
                local wp = cf * Vector3.new(sz.X/2*x, sz.Y/2*y, sz.Z/2*z)
                local sp, on = camera:WorldToViewportPoint(wp)
                if on then table.insert(corners, Vector2.new(sp.X, sp.Y)) end
            end end end
        end
    end
    if #corners < 1 then return nil end
    local minX, maxX = math.huge, -math.huge
    local minY, maxY = math.huge, -math.huge
    for _, c in ipairs(corners) do
        minX = math.min(minX, c.X); maxX = math.max(maxX, c.X)
        minY = math.min(minY, c.Y); maxY = math.max(maxY, c.Y)
    end
    return { minX = minX, maxX = maxX, minY = minY, maxY = maxY }
end

local ESPObjects = {}

local function DestroyESP(player)
    local o = ESPObjects[player]
    if not o then return end
    if o.CornerLines then for _, l in ipairs(o.CornerLines) do if l then l:Remove() end end end
    if o.BoxLines then for _, l in ipairs(o.BoxLines) do if l then l:Remove() end end end
    if o.FilledLines then for _, l in ipairs(o.FilledLines) do if l then l:Remove() end end end
    if o.SkeletonLines then for _, l in ipairs(o.SkeletonLines) do if l then l:Remove() end end end
    if o.HealthBarBg then o.HealthBarBg:Remove() end
    if o.HealthBarFill then o.HealthBarFill:Remove() end
    if o.NameText then o.NameText:Remove() end
    if o.DistText then o.DistText:Remove() end
    if o.HeadDot then o.HeadDot:Remove() end
    ESPObjects[player] = nil
end

local function CreateESP(targetData)
    local o = {}
    o.CornerLines = {}
    for i = 1, 8 do
        local l = CreateLine(); if l then table.insert(o.CornerLines, l) end
    end
    o.BoxLines = {}
    for i = 1, 4 do
        local l = CreateLine(); if l then table.insert(o.BoxLines, l) end
    end
    o.FilledLines = {}
    for i = 1, Settings.FilledBoxSteps do
        local l = CreateLine(); if l then table.insert(o.FilledLines, l) end
    end
    o.SkeletonLines = {}
    for i = 1, 5 do
        local l = CreateLine(); if l then table.insert(o.SkeletonLines, l) end
    end
    o.HealthBarBg = CreateLine()
    o.HealthBarFill = CreateLine()
    o.NameText = CreateText()
    o.DistText = CreateText()
    o.HeadDot = CreateCircle()
    o.Character = targetData.Character
    o.LastBox = nil
    ESPObjects[targetData.Player] = o
    return o
end

local function UpdateBox(o)
    local box = o.LastBox
    if not Settings.Box or not box then
        for _, l in ipairs(o.CornerLines) do l.Visible = false end
        for _, l in ipairs(o.BoxLines) do l.Visible = false end
        for _, l in ipairs(o.FilledLines) do l.Visible = false end
        return
    end

    local minX, maxX, minY, maxY = box.minX, box.maxX, box.minY, box.maxY
    local w, h = maxX - minX, maxY - minY

    if Settings.FilledBox and #o.FilledLines > 0 then
        local bottomAlpha = Settings.FilledBoxBottomAlpha
        if Settings.FilledBoxAdaptive and o.Character then
            local hrp = o.Character:FindFirstChild("Torso") or o.Character:FindFirstChild("Head")
            if hrp then
                local dist = (camera.CFrame.Position - hrp.Position).Magnitude
                local nearD, farD = Settings.FilledBoxNearDist, Settings.FilledBoxFarDist
                if dist <= nearD then
                    bottomAlpha = Settings.FilledBoxNearAlpha
                elseif dist >= farD then
                    bottomAlpha = Settings.FilledBoxFarAlpha
                else
                    local t = (dist - nearD) / (farD - nearD)
                    bottomAlpha = Settings.FilledBoxNearAlpha + (Settings.FilledBoxFarAlpha - Settings.FilledBoxNearAlpha) * t
                end
            end
        end
        local steps = Settings.FilledBoxSteps
        local boxH = math.max(h, 1)
        for i = 1, steps do
            local line = o.FilledLines[i]
            if line then
                local t = (i - 1) / math.max(steps - 1, 1)
                local y = maxY - t * boxH
                local alpha = bottomAlpha + (Settings.FilledBoxTopAlpha - bottomAlpha) * t
                line.From = Vector2.new(minX, y)
                line.To = Vector2.new(maxX, y)
                line.Color = o.CurrentColor or Settings.BoxColor
                line.Thickness = math.max(1, math.ceil(boxH / steps) + 1)
                line.Transparency = alpha
                line.Visible = true
            end
        end
    else
        for _, l in ipairs(o.FilledLines) do l.Visible = false end
    end

    if Settings.BoxMode == "Corner" then
        local len = math.min(w, h) * Settings.CornerLength
        local segments = {
            {Vector2.new(minX, minY), Vector2.new(minX + len, minY)},
            {Vector2.new(minX, minY), Vector2.new(minX, minY + len)},
            {Vector2.new(maxX, minY), Vector2.new(maxX - len, minY)},
            {Vector2.new(maxX, minY), Vector2.new(maxX, minY + len)},
            {Vector2.new(minX, maxY), Vector2.new(minX + len, maxY)},
            {Vector2.new(minX, maxY), Vector2.new(minX, maxY - len)},
            {Vector2.new(maxX, maxY), Vector2.new(maxX - len, maxY)},
            {Vector2.new(maxX, maxY), Vector2.new(maxX, maxY - len)},
        }
        for i, seg in ipairs(segments) do
            local l = o.CornerLines[i]
            if l then
                l.From = seg[1]; l.To = seg[2]
                l.Color = o.CurrentColor or Settings.BoxColor
                l.Thickness = Settings.BoxThickness
                l.Visible = true
            end
        end
        for _, l in ipairs(o.BoxLines) do l.Visible = false end
    else
        local segments = {
            {Vector2.new(minX, minY), Vector2.new(maxX, minY)},
            {Vector2.new(maxX, minY), Vector2.new(maxX, maxY)},
            {Vector2.new(maxX, maxY), Vector2.new(minX, maxY)},
            {Vector2.new(minX, maxY), Vector2.new(minX, minY)},
        }
        for i, seg in ipairs(segments) do
            local l = o.BoxLines[i]
            if l then
                l.From = seg[1]; l.To = seg[2]
                l.Color = o.CurrentColor or Settings.BoxColor
                l.Thickness = Settings.BoxThickness
                l.Visible = true
            end
        end
        for _, l in ipairs(o.CornerLines) do l.Visible = false end
    end
end

local SKELETON_CONNECTIONS = {
    {"Head", "Torso"}, {"Torso", "Left Arm"}, {"Torso", "Right Arm"},
    {"Torso", "Left Leg"}, {"Torso", "Right Leg"},
}

local function UpdateSkeleton(char, o)
    for _, l in ipairs(o.SkeletonLines) do l.Visible = false end
    if not Settings.Skeleton then return end
    local idx = 1
    for _, conn in ipairs(SKELETON_CONNECTIONS) do
        local p1 = char:FindFirstChild(conn[1])
        local p2 = char:FindFirstChild(conn[2])
        if p1 and p2 and p1:IsA("BasePart") and p2:IsA("BasePart") then
            local s1, on1 = camera:WorldToViewportPoint(p1.Position)
            local s2, on2 = camera:WorldToViewportPoint(p2.Position)
            local l = o.SkeletonLines[idx]
            if l then
                if on1 and on2 then
                    l.From = Vector2.new(s1.X, s1.Y)
                    l.To = Vector2.new(s2.X, s2.Y)
                    l.Color = Settings.SkeletonColor
                    l.Thickness = Settings.SkeletonThickness
                    l.Visible = true
                end
                idx = idx + 1
            end
        end
    end
end

local function UpdateESP()
    if not Settings.ESP then
        for p in pairs(ESPObjects) do DestroyESP(p) end
        return
    end
    local current = {}
    for _, targetData in ipairs(CachedTargets) do
        local player = targetData.Player
        local char = targetData.Character
        current[player] = true

        local o = ESPObjects[player]
        if not o or o.Character ~= char then
            if o then DestroyESP(player) end
            o = CreateESP(targetData)
        end

        local currentColor = Settings.BoxColor
        if Settings.WallCheck then
            local isVisible = false
            for _, partName in ipairs({"Torso", "Head"}) do
                local part = char:FindFirstChild(partName)
                if part and IsVisible(part) then isVisible = true; break end
            end
            currentColor = isVisible and Settings.VisibleColor or Settings.OccludedColor
        end
        o.CurrentColor = currentColor

        o.LastBox = CalculateBounds(char)
        UpdateBox(o)
        UpdateSkeleton(char, o)

        local hp, maxHp = targetData.Health, targetData.MaxHealth
        local ratio = math.clamp(hp / maxHp, 0, 1)

        if o.LastBox and Settings.HealthBar then
            local box = o.LastBox
            local barX = box.minX - Settings.HealthBarOffset
            local barTop, barBottom = box.minY, box.maxY
            local fillTop = barBottom - (barBottom - barTop) * ratio
            if o.HealthBarBg then
                o.HealthBarBg.From = Vector2.new(barX, barTop)
                o.HealthBarBg.To = Vector2.new(barX, barBottom)
                o.HealthBarBg.Color = Color3.fromRGB(30, 30, 30)
                o.HealthBarBg.Thickness = Settings.HealthBarWidth
                o.HealthBarBg.Visible = true
            end
            if o.HealthBarFill then
                o.HealthBarFill.From = Vector2.new(barX, fillTop)
                o.HealthBarFill.To = Vector2.new(barX, barBottom)
                o.HealthBarFill.Color = Color3.fromRGB((1 - ratio) * 255, ratio * 255, 0)
                o.HealthBarFill.Thickness = Settings.HealthBarWidth
                o.HealthBarFill.Visible = true
            end
        else
            if o.HealthBarBg then o.HealthBarBg.Visible = false end
            if o.HealthBarFill then o.HealthBarFill.Visible = false end
        end

        if o.LastBox then
            local box = o.LastBox
            local centerX = (box.minX + box.maxX) / 2
            if o.NameText then
                if Settings.Name then
                    o.NameText.Text = player.DisplayName
                    o.NameText.Size = Settings.NameSize
                    o.NameText.Color = Settings.NameColor
                    o.NameText.Position = Vector2.new(centerX, box.minY - Settings.NameSize - 4)
                    o.NameText.Visible = true
                else o.NameText.Visible = false end
            end
            if o.DistText then
                if Settings.Distance and targetData.Torso then
                    local dist = (camera.CFrame.Position - targetData.Torso.Position).Magnitude
                    o.DistText.Text = string.format("%.0f studs", dist)
                    o.DistText.Size = Settings.DistanceSize
                    o.DistText.Color = Settings.DistanceColor
                    o.DistText.Position = Vector2.new(centerX, box.maxY + 4)
                    o.DistText.Visible = true
                else o.DistText.Visible = false end
            end
        else
            if o.NameText then o.NameText.Visible = false end
            if o.DistText then o.DistText.Visible = false end
        end

        if o.HeadDot and Settings.HeadDot and targetData.Head then
            local hp2, on = camera:WorldToViewportPoint(targetData.Head.Position)
            if on then
                o.HeadDot.Position = Vector2.new(hp2.X, hp2.Y)
                o.HeadDot.Radius = Settings.HeadDotSize
                o.HeadDot.Color = Settings.HeadDotColor
                o.HeadDot.Visible = true
            else o.HeadDot.Visible = false end
        elseif o.HeadDot then o.HeadDot.Visible = false end
    end
    for player in pairs(ESPObjects) do
        if not current[player] then DestroyESP(player) end
    end
end

