    function UI:AddGroupbox(tabName, side, title, order)
        local tab = UI.Tabs[tabName]; if not tab then return end
        local parent = (side == "Right") and tab.Right or tab.Left
        local N = function(cls, props)
            local i = Instance.new(cls)
            for k, v in pairs(props or {}) do i[k] = v end
            return i
        end
        local group = N("Frame", {
            Size = UDim2.new(1, 0, 0, 30),
            BackgroundColor3 = Color3.fromRGB(22, 24, 29),
            BorderSizePixel = 0, LayoutOrder = order or 1,
            AutomaticSize = Enum.AutomaticSize.Y, Parent = parent,
        })
        local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 6); c.Parent = group
        local s = Instance.new("UIStroke"); s.Color = Color3.fromRGB(34, 37, 43); s.Thickness = 1; s.Parent = group
        local p = Instance.new("UIPadding")
        p.PaddingTop = UDim.new(0, 12); p.PaddingBottom = UDim.new(0, 12)
        p.PaddingLeft = UDim.new(0, 14); p.PaddingRight = UDim.new(0, 14)
        p.Parent = group
        N("TextLabel", {
            Size = UDim2.new(1, 0, 0, 14), BackgroundTransparency = 1,
            Text = string.upper(title), TextColor3 = Color3.fromRGB(122, 127, 136),
            TextSize = 11, Font = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Left, Parent = group,
        })
        local container = N("Frame", {
            Name = "Container", Size = UDim2.new(1, 0, 0, 0),
            Position = UDim2.new(0, 0, 0, 22), BackgroundTransparency = 1,
            AutomaticSize = Enum.AutomaticSize.Y, Parent = group,
        })
        N("UIListLayout", {
            FillDirection = Enum.FillDirection.Vertical,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 10), Parent = container,
        })
        UI.Tabs[tabName].Groups = UI.Tabs[tabName].Groups or {}
        UI.Tabs[tabName].Groups[title] = { Frame = group, Container = container }
        return UI.Tabs[tabName].Groups[title]
    end
end

