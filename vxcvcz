local BODY_PARTS = { "Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg" }

local MAX_HP_MAP = {
    Head = 50, Torso = 150,
    ["Left Arm"] = 100, ["Right Arm"] = 100,
    ["Left Leg"] = 100, ["Right Leg"] = 100,
}

local function GetHealth(char)
    if not char then return 0, 1 end
    local total, maxTotal = 0, 0
    for _, name in ipairs(BODY_PARTS) do
        local part = char:FindFirstChild(name)
        if part then
            local hp = part:FindFirstChild("Health")
            if hp and hp:IsA("ValueBase") then
                total = total + hp.Value
                maxTotal = maxTotal + (MAX_HP_MAP[name] or 100)
            end
        end
    end
    if maxTotal == 0 then return 0, 600 end
    return total, maxTotal
end

local function IsVisible(part)
    if not part then return false end
    local origin = camera.CFrame.Position
    local direction = part.Position - origin
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true
    local exclude = { camera }
    if LocalPlayer.Character then table.insert(exclude, LocalPlayer.Character) end
    params.FilterDescendantsInstances = exclude
    local result = Workspace:Raycast(origin, direction, params)
    if not result then return true end
    if result.Instance == part then return true end
    if result.Instance:IsDescendantOf(part.Parent) then return true end
    return false
end

local function GetChar(player)
    if not player then return nil end
    local charsFolder = Workspace:FindFirstChild("Characters")
    if not charsFolder then return nil end
    return charsFolder:FindFirstChild(player.Name)
end

local CachedTargets = {}

local function UpdateTargetCache()
    local list = {}
    local charsFolder = Workspace:FindFirstChild("Characters")
    if not charsFolder then CachedTargets = list; return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if Settings.TeamCheck and myTeam and player.Team == myTeam then continue end
        local char = charsFolder:FindFirstChild(player.Name)
        if not char or not char.Parent then continue end
        local head = char:FindFirstChild("Head")
        local torso = char:FindFirstChild("Torso")
        if not head or not torso then continue end
        local hp, maxHp = GetHealth(char)
        if hp <= 0 then continue end
        table.insert(list, {
            Player = player, Character = char,
            Head = head, Torso = torso,
            Health = hp, MaxHealth = maxHp,
        })
    end
    CachedTargets = list
end

